# CarTrust AI Environment Configuration

APP_NAME=CarTrust AI
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=cartrust-super-secret-key-change-in-production-min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL or SQLite fallback for local test/dev)
DATABASE_URL=sqlite:///./cartrust.db

# Redis Cache & Background Queue
REDIS_URL=redis://localhost:6379/0

# Mail Service (Mailpit local SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@cartrust.demo
EMAILS_FROM_NAME=CarTrust AI
FRONTEND_URL=http://localhost:5173

# Document Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Mock Provider API
MOCK_PROVIDER_URL=http://localhost:8001

# AI / LLM Configuration
USE_MOCK_LLM=true
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
